            {
              "__type": "Talking",
              "__guid": "d4069dfe-b78b-4a41-95cf-ce67e79c8baa",
              "__enabled": true,
              "Flags": 0,
              "OnComponentDestroy": null,
              "OnComponentDisabled": null,
              "OnComponentEnabled": null,
              "OnComponentFixedUpdate": null,
              "OnComponentStart": null,
              "OnComponentUpdate": null,
              "PromptMessage": "Говорить с Молочником"
            },
            {
              "__type": "DialogueController",
              "__guid": "65a3988a-9281-4332-98c3-4534bc74e5a9",
              "__enabled": true,
              "Flags": 0,
              "dialogue": [
                {
                  "Name": "Встреча с Молочником",
                  "Description": "Проверка выдачи квеста подбора оружия и его выполнения",
                  "DialogueLine": [
                    {
                      "Name": "Толян",
                      "Text": "Дарова, молоко.",
                      "Sound": "sound/dialogue/test/milkmantakeweapon/1_tol_1.vsnd",
                      "TimeSound": 1.8407936,
                      "EnableQuest": false,
                      "Quest": {
                        "Name": null,
                        "Objectives": [],
                        "Required": false,
                        "IsCompleted": true
                      }
                    },
                    {
                      "Name": "Толян",
                      "Text": "Есть ли у тебя задания для проверки этой ахуенной игры?",
                      "Sound": "sound/dialogue/test/milkmantakeweapon/2_tol_2.vsnd",
                      "TimeSound": 3.175941,
                      "EnableQuest": false,
                      "Quest": {
                        "Name": null,
                        "Objectives": [],
                        "Required": false,
                        "IsCompleted": true
                      }
                    },
                    {
                      "Name": "Молоко",
                      "Text": "Привет, петух.",
                      "Sound": "sound/dialogue/test/milkmantakeweapon/3_milk_1.vsnd",
                      "TimeSound": 1.7479138,
                      "EnableQuest": false,
                      "Quest": {
                        "Name": null,
                        "Objectives": [],
                        "Required": false,
                        "IsCompleted": true
                      }
                    },
                    {
                      "Name": "Молоко",
                      "Text": "Да, есть конечно.",
                      "Sound": "sound/dialogue/test/milkmantakeweapon/4_milk_2.vsnd",
                      "TimeSound": 1.9568934,
                      "EnableQuest": false,
                      "Quest": {
                        "Name": null,
                        "Objectives": [],
                        "Required": false,
                        "IsCompleted": true
                      }
                    },
                    {
                      "Name": "Толян",
                      "Text": "И какие же?",
                      "Sound": "sound/dialogue/test/milkmantakeweapon/5_tol_3.vsnd",
                      "TimeSound": 1.3647846,
                      "EnableQuest": false,
                      "Quest": {
                        "Name": null,
                        "Objectives": [],
                        "Required": false,
                        "IsCompleted": true
                      }
                    },
                    {
                      "Name": "Молоко",
                      "Text": "Для начала возьми оружие и надень броню, сосунок.",
                      "Sound": "sound/dialogue/test/milkmantakeweapon/6_milk_3.vsnd",
                      "TimeSound": 4.093,
                      "EnableQuest": true,
                      "Quest": {
                        "Name": "Вооружение",
                        "Objectives": [
                          {
                            "Name": "Найди и возьми оружие.",
                            "Type": "Collect",
                            "TargetTag": "weapon",
                            "CurrentProgress": 0,
                            "RequiredProgress": 1,
                            "IsCompleted": false
                          },
                          {
                            "Name": "Найди и надень броню.",
                            "Type": "Collect",
                            "TargetTag": "armor",
                            "CurrentProgress": 0,
                            "RequiredProgress": 1,
                            "IsCompleted": false
                          }
                        ],
                        "Required": true,
                        "IsCompleted": false
                      }
                    },
                    {
                      "Name": "Молоко",
                      "Text": "Их можно найти на стендах.",
                      "Sound": "sound/dialogue/test/milkmantakeweapon/7_milk_4.vsnd",
                      "TimeSound": 2.293,
                      "EnableQuest": false,
                      "Quest": {
                        "Name": null,
                        "Objectives": [],
                        "Required": false,
                        "IsCompleted": true
                      }
                    },
                    {
                      "Name": "Толян",
                      "Text": "Окей, секунду.",
                      "Sound": "sound/dialogue/test/milkmantakeweapon/8_tol_4.vsnd",
                      "TimeSound": 1.8756236,
                      "EnableQuest": false,
                      "Quest": {
                        "Name": null,
                        "Objectives": [],
                        "Required": false,
                        "IsCompleted": true
                      }
                    }
                  ]
                },
                {
                  "Name": "Приказ от Молочника",
                  "Description": "Молочник приказал убаить зомби возле дома.",
                  "DialogueLine": [
                    {
                      "Name": "Молоко",
                      "Text": "Убей нахуй этого зомби возле дома.",
                      "Sound": "sound/dialogue/test/milkmankillzombie/1_milk_1.vsnd",
                      "TimeSound": 3.1759374,
                      "EnableQuest": true,
                      "Quest": {
                        "Name": "Упокой его",
                        "Objectives": [
                          {
                            "Name": "Убей зомби возле дома.",
                            "Type": "Kill",
                            "TargetTag": "zombie",
                            "CurrentProgress": 0,
                            "RequiredProgress": 1,
                            "IsCompleted": false
                          }
                        ],
                        "Required": false,
                        "IsCompleted": false
                      }
                    },
                    {
                      "Name": "Толян",
                      "Text": "Зачем?",
                      "Sound": "sound/dialogue/test/milkmankillzombie/2_tol_1.vsnd",
                      "TimeSound": 1.1209583,
                      "EnableQuest": false,
                      "Quest": {
                        "Name": null,
                        "Objectives": [],
                        "Required": false,
                        "IsCompleted": true
                      }
                    },
                    {
                      "Name": "Молоко",
                      "Text": "Это остаток от доширака, упокой его с миром.",
                      "Sound": "sound/dialogue/test/milkmankillzombie/3_milk_2.vsnd",
                      "TimeSound": 3.5590625,
                      "EnableQuest": false,
                      "Quest": null
                    },
                    {
                      "Name": "Толян",
                      "Text": "Хорошо, давай поконьчим с ним.",
                      "Sound": "sound/dialogue/test/milkmankillzombie/4_tol_2.vsnd",
                      "TimeSound": 2.3289793,
                      "EnableQuest": false,
                      "Quest": {
                        "Name": null,
                        "Objectives": [],
                        "Required": false,
                        "IsCompleted": true
                      }
                    }
                  ]
                },
                {
                  "Name": "КонцовОЧКА",
                  "Description": "Молочник благодарит за выполнение квестов",
                  "DialogueLine": [
                    {
                      "Name": "Толян",
                      "Text": "Всё готово, что дальше?",
                      "Sound": "sound/dialogue/test/milkmanend/1_tol_1.vsnd",
                      "TimeSound": 1.98,
                      "EnableQuest": false,
                      "Quest": {
                        "Name": null,
                        "Objectives": [],
                        "Required": false,
                        "IsCompleted": true
                      }
                    },
                    {
                      "Name": "Молоко",
                      "Text": "Красава маратик.",
                      "Sound": "sound/dialogue/test/milkmanend/2_milk_1.vsnd",
                      "TimeSound": 1.643,
                      "EnableQuest": false,
                      "Quest": {
                        "Name": null,
                        "Objectives": [],
                        "Required": false,
                        "IsCompleted": true
                      }
                    },
                    {
                      "Name": "Молоко",
                      "Text": "На этом проверку игры можно закончить.",
                      "Sound": "sound/dialogue/test/milkmanend/3_milk_2.vsnd",
                      "TimeSound": 3.025,
                      "EnableQuest": false,
                      "Quest": {
                        "Name": null,
                        "Objectives": [],
                        "Required": false,
                        "IsCompleted": true
                      }
                    },
                    {
                      "Name": "Толян",
                      "Text": "Окей, тогда я пойду.",
                      "Sound": "sound/dialogue/test/milkmanend/4_tol_2.vsnd",
                      "TimeSound": 2.03,
                      "EnableQuest": true,
                      "Quest": {
                        "Name": "Убей себя",
                        "Objectives": [
                          {
                            "Name": "Войди в красную зону",
                            "Type": "Reach",
                            "TargetTag": "damagezone",
                            "CurrentProgress": 0,
                            "RequiredProgress": 1,
                            "IsCompleted": false
                          }
                        ],
                        "Required": false,
                        "IsCompleted": false
                      }
                    },
                    {
                      "Name": "Молоко",
                      "Text": "Удачи, жди первой главы.",
                      "Sound": "sound/dialogue/test/milkmanend/5_milk_3.vsnd",
                      "TimeSound": 2.374,
                      "EnableQuest": false,
                      "Quest": {
                        "Name": null,
                        "Objectives": [],
                        "Required": false,
                        "IsCompleted": true
                      }
                    }
                  ]
                }
              ],
              "OnComponentDestroy": null,
              "OnComponentDisabled": null,
              "OnComponentEnabled": null,
              "OnComponentFixedUpdate": null,
              "OnComponentStart": null,
              "OnComponentUpdate": null
            }
          ],
          "Children": [
